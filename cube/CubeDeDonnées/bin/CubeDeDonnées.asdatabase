      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>CALCULATE;

/* ============================================================================
   WEIGHTED GINI - WORKING VERSION
   ============================================================================ */

CREATE MEMBER CURRENTCUBE.[Measures].[Weighted Gini]
AS 
IIF(
    [Dim Geography].[Country Name].CurrentMember.Level 
        IS 
        [Dim Geography].[Country Name].[Country Name],
    
    ([Measures].[Value - Fact Inequality], [Dim Indicator].[Indicator Key].&amp;[9]),
    
    AVG(
        EXISTING [Dim Geography].[Country Name].[Country Name].MEMBERS,
        ([Measures].[Value - Fact Inequality], [Dim Indicator].[Indicator Key].&amp;[9])
    )
),
FORMAT_STRING = "#,#0.0",
VISIBLE = 1;

/* ============================================================================
   KPI SUPPORTING MEASURES
   ============================================================================ */

-- Current Gini Value
CREATE MEMBER CURRENTCUBE.[Measures].[Current Gini]
AS 
([Measures].[Value - Fact Inequality], [Dim Indicator].[Indicator Key].&amp;[9]),
FORMAT_STRING = "#,#0.0",
VISIBLE = 0;

-- Previous Year Gini (Target)
CREATE MEMBER CURRENTCUBE.[Measures].[Previous Year Gini]
AS 
([Measures].[Value - Fact Inequality], [Dim Indicator].[Indicator Key].&amp;[9], [Dim Time].[Year].CURRENTMEMBER.PREVMEMBER),
FORMAT_STRING = "#,#0.0",
VISIBLE = 0;

-- Gini Change (negative is good)
CREATE MEMBER CURRENTCUBE.[Measures].[Gini Change]
AS 
IIF(
    NOT ISEMPTY([Measures].[Previous Year Gini]),
    [Measures].[Current Gini] - [Measures].[Previous Year Gini],
    NULL
),
FORMAT_STRING = "#,#0.0",
VISIBLE = 0;

CREATE MEMBER CURRENTCUBE.[Measures].[Gini 3Year Trend]
AS
IIF(
    -- check if a previous non-empty year exists
    IsEmpty(
        (
            [Measures].[Value - Fact Inequality],
            [Dim Indicator].[Indicator Key].&amp;[9],
            TAIL(
                NONEMPTY(
                    [Dim Time].[Year].MEMBERS,
                    ([Measures].[Value - Fact Inequality],
                     [Dim Indicator].[Indicator Key].&amp;[9])
                ),
                2
            ).ITEM(0)
        )
    ),
    NULL,
    (
        [Measures].[Value - Fact Inequality],
        [Dim Indicator].[Indicator Key].&amp;[9]
    )
    -
    (
        [Measures].[Value - Fact Inequality],
        [Dim Indicator].[Indicator Key].&amp;[9],
        TAIL(
            NONEMPTY(
                [Dim Time].[Year].MEMBERS,
                ([Measures].[Value - Fact Inequality],
                 [Dim Indicator].[Indicator Key].&amp;[9])
            ),
            2
        ).ITEM(0)
    )
),
FORMAT_STRING = "#,#0.0",
VISIBLE = 0;
/* Palma Ratio - Current */
CREATE MEMBER CURRENTCUBE.[Measures].[Palma Current]
AS ([Measures].[Value - Fact Inequality],
    [Dim Indicator].[Indicator Key].&amp;[10]),
VISIBLE = 0;

/* Palma Ratio - Previous Year */
CREATE MEMBER CURRENTCUBE.[Measures].[Palma Prev]
AS ([Measures].[Value - Fact Inequality],
    [Dim Indicator].[Indicator Key].&amp;[10],
    [Dim Time].[Year].CURRENTMEMBER.PREVMEMBER),
VISIBLE = 0;

/* Palma Change */
CREATE MEMBER CURRENTCUBE.[Measures].[Palma Change]
AS IIF(
    ISEMPTY([Measures].[Palma Prev]),
    NULL,
    [Measures].[Palma Current] - [Measures].[Palma Prev]
),
VISIBLE = 0;

/* Palma Smart Trend */
CREATE MEMBER CURRENTCUBE.[Measures].[Palma Trend]
AS
IIF(
    ISEMPTY(
        (
            [Measures].[Value - Fact Inequality],
            [Dim Indicator].[Indicator Key].&amp;[10],
            TAIL(
                NONEMPTY(
                    [Dim Time].[Year].MEMBERS,
                    ([Measures].[Value - Fact Inequality],
                     [Dim Indicator].[Indicator Key].&amp;[10])
                ),
                2
            ).ITEM(0)
        )
    ),
    NULL,
    ([Measures].[Value - Fact Inequality],
     [Dim Indicator].[Indicator Key].&amp;[10])
    -
    ([Measures].[Value - Fact Inequality],
     [Dim Indicator].[Indicator Key].&amp;[10],
     TAIL(
         NONEMPTY(
             [Dim Time].[Year].MEMBERS,
             ([Measures].[Value - Fact Inequality],
              [Dim Indicator].[Indicator Key].&amp;[10])
         ),
         2
     ).ITEM(0))
),
VISIBLE = 0;
/* Unemployment - Current */
CREATE MEMBER CURRENTCUBE.[Measures].[Unemployment Current]
AS ([Measures].[Value],
    [Dim Indicator].[Indicator Key].&amp;[0]),
VISIBLE = 0;

/* Previous Year */
CREATE MEMBER CURRENTCUBE.[Measures].[Unemployment Prev]
AS ([Measures].[Value],
    [Dim Indicator].[Indicator Key].&amp;[0],
    [Dim Time].[Year].CURRENTMEMBER.PREVMEMBER),
VISIBLE = 0;

/* Change (negative = good) */
CREATE MEMBER CURRENTCUBE.[Measures].[Unemployment Change]
AS IIF(
    ISEMPTY([Measures].[Unemployment Prev]),
    NULL,
    [Measures].[Unemployment Current] - [Measures].[Unemployment Prev]
),
VISIBLE = 0;

/* Smart Trend (last non-empty year) */
CREATE MEMBER CURRENTCUBE.[Measures].[Unemployment Trend]
AS
IIF(
    ISEMPTY((
        [Measures].[Value],
        [Dim Indicator].[Indicator Key].&amp;[0],
        TAIL(
            NONEMPTY(
                [Dim Time].[Year].MEMBERS,
                ([Measures].[Value],
                 [Dim Indicator].[Indicator Key].&amp;[0])
            ),
            2
        ).ITEM(0)
    )),
    NULL,
    ([Measures].[Value],
     [Dim Indicator].[Indicator Key].&amp;[0])
    -
    ([Measures].[Value],
     [Dim Indicator].[Indicator Key].&amp;[0],
     TAIL(
         NONEMPTY(
             [Dim Time].[Year].MEMBERS,
             ([Measures].[Value],
              [Dim Indicator].[Indicator Key].&amp;[0])
         ),
         2
     ).ITEM(0))
),
VISIBLE = 0;
/* Literacy - Current */
CREATE MEMBER CURRENTCUBE.[Measures].[Literacy Current]
AS (
    [Measures].[Value - Fact Social Development],
    [Dim Indicator].[Indicator Key].&amp;[7]
),
VISIBLE = 0;
/* Literacy - Previous Year */
CREATE MEMBER CURRENTCUBE.[Measures].[Literacy Prev]
AS (
    [Measures].[Value - Fact Social Development],
    [Dim Indicator].[Indicator Key].&amp;[7],
    [Dim Time].[Year].CURRENTMEMBER.PREVMEMBER
),
VISIBLE = 0;
/* Literacy Change */
CREATE MEMBER CURRENTCUBE.[Measures].[Literacy Change]
AS IIF(
    ISEMPTY([Measures].[Literacy Prev]),
    NULL,
    [Measures].[Literacy Current] - [Measures].[Literacy Prev]
),
VISIBLE = 0;
/* Literacy - Smart Trend */
CREATE MEMBER CURRENTCUBE.[Measures].[Literacy Trend]
AS
IIF(
    ISEMPTY((
        [Measures].[Value - Fact Social Development],
        [Dim Indicator].[Indicator Key].&amp;[7],
        TAIL(
            NONEMPTY(
                [Dim Time].[Year].MEMBERS,
                (
                    [Measures].[Value - Fact Social Development],
                    [Dim Indicator].[Indicator Key].&amp;[7]
                )
            ),
            2
        ).ITEM(0)
    )),
    NULL,
    (
        [Measures].[Value - Fact Social Development],
        [Dim Indicator].[Indicator Key].&amp;[7]
    )
    -
    (
        [Measures].[Value - Fact Social Development],
        [Dim Indicator].[Indicator Key].&amp;[7],
        TAIL(
            NONEMPTY(
                [Dim Time].[Year].MEMBERS,
                (
                    [Measures].[Value - Fact Social Development],
                    [Dim Indicator].[Indicator Key].&amp;[7]
                )
            ),
            2
        ).ITEM(0)
    )
),
VISIBLE = 0;
</Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
      <Kpis>
        <Kpi>
          <ID>KPI</ID>
          <Name>Inequality Reduction Progress</Name>
          <AssociatedMeasureGroupID>Fact Social Development</AssociatedMeasureGroupID>
          <Value>([Measures].[Value - Fact Inequality], [Dim Indicator].[Indicator Key].&amp;[9])
</Value>
          <Goal>([Measures].[Value - Fact Inequality], [Dim Indicator].[Indicator Key].&amp;[9], [Dim Time].[Year].CURRENTMEMBER.PREVMEMBER)
</Goal>
          <Status>CASE
    WHEN [Measures].[Gini Change] IS NULL THEN NULL
    WHEN [Measures].[Gini Change] &lt; -0.5 THEN 1
    WHEN [Measures].[Gini Change] &gt; 0.5 THEN -1
    ELSE 0
END
</Status>
          <Trend>CASE
    WHEN [Measures].[Gini 3Year Trend] IS NULL THEN NULL
    WHEN [Measures].[Gini 3Year Trend] &lt; -1 THEN 1
    WHEN [Measures].[Gini 3Year Trend] &gt; 1 THEN -1
    ELSE 0
END
</Trend>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Ascending</StatusGraphic>
        </Kpi>
        <Kpi>
          <ID>KPI 1</ID>
          <Name>InequalityGapReductionPalma</Name>
          <AssociatedMeasureGroupID>Fact Inequality</AssociatedMeasureGroupID>
          <Value>[Measures].[Palma Current]
</Value>
          <Goal>[Measures].[Palma Prev]
</Goal>
          <Status>CASE
    WHEN [Measures].[Palma Change] &lt; 0 THEN 1   -- Green (improving)
    WHEN [Measures].[Palma Change] &gt; 0 THEN -1  -- Red (worsening)
    ELSE 0                                      -- Yellow
END
</Status>
          <Trend>CASE
    WHEN [Measures].[Palma Trend] &lt; 0 THEN 1
    WHEN [Measures].[Palma Trend] &gt; 0 THEN -1
    ELSE 0
END
</Trend>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Ascending</StatusGraphic>
        </Kpi>
        <Kpi>
          <ID>KPI 2</ID>
          <Name>Labor Market ImprovementUnemployment</Name>
          <AssociatedMeasureGroupID>Fact Economy</AssociatedMeasureGroupID>
          <Value>[Measures].[Unemployment Current]</Value>
          <Goal>[Measures].[Unemployment Prev]</Goal>
          <Status>CASE
    WHEN [Measures].[Unemployment Change] &lt; 0 THEN 1
    WHEN [Measures].[Unemployment Change] &gt; 0 THEN -1
    ELSE 0
END
</Status>
          <Trend>CASE
    WHEN [Measures].[Unemployment Trend] &lt; 0 THEN 1
    WHEN [Measures].[Unemployment Trend] &gt; 0 THEN -1
    ELSE 0
END
</Trend>
          <TrendGraphic>Status Arrow - Ascending</TrendGraphic>
          <StatusGraphic>Gauge - Descending</StatusGraphic>
        </Kpi>
        <Kpi>
          <ID>KPI 3</ID>
          <Name>Education Progress Literacy Rate</Name>
          <AssociatedMeasureGroupID>Fact Social Development</AssociatedMeasureGroupID>
          <Value>[Measures].[Literacy Current]
</Value>
          <Goal>[Measures].[Literacy Prev]
</Goal>
          <Status>CASE
    WHEN [Measures].[Literacy Change] IS NULL THEN NULL
    WHEN [Measures].[Literacy Change] &gt; 0 THEN 1    -- improving
    WHEN [Measures].[Literacy Change] &lt; 0 THEN -1   -- worsening
    ELSE 0                                          -- stagnant
END
</Status>
          <Trend>CASE
    WHEN [Measures].[Literacy Trend] IS NULL THEN NULL
    WHEN [Measures].[Literacy Trend] &gt; 0 THEN 1
    WHEN [Measures].[Literacy Trend] &lt; 0 THEN -1
    ELSE 0
END
</Trend>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Descending</StatusGraphic>
        </Kpi>
      </Kpis>
